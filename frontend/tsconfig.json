{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "esModuleInterop": true, "noEmit": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "*.ts", "tests"]
}
