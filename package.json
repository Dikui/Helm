{
  "name": "helm",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "helm": "dist/src/cli.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc && vite build --config frontend/vite.config.ts",
    "check": "tsc --noEmit && tsc -p frontend/tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=4 dist/tests/*.test.js && npm run test:ui",
    "test:real": "npm run build && node dist/tests/real-smoke-runner.js",
    "test:attachments": "npm run build && HELM_ATTACHMENTS_REAL=1 node --test dist/tests/attachments.real.js",
    "browser:install": "node node_modules/@playwright/mcp/cli.js install-browser chromium --no-shell",
    "test:browser": "npm run build && HELM_BROWSER_REAL=1 node --test dist/tests/browser.real.js",
    "test:claude-executor": "npm run build && HELM_CLAUDE_EXECUTOR_REAL=1 node --test dist/tests/claude-executor.real.js",
    "test:claude-coordinator": "npm run build && HELM_CLAUDE_COORDINATOR_REAL=1 node --test dist/tests/claude-coordinator.real.js",
    "test:codex-executor": "npm run build && HELM_CODEX_EXECUTOR_REAL=1 node --test dist/tests/codex-executor.real.js",
    "test:codex-coordinator": "npm run build && HELM_CODEX_COORDINATOR_REAL=1 node --test dist/tests/codex-coordinator.real.js",
    "start": "node dist/src/cli.js",
    "test:ui": "tsc && vitest run --config frontend/vitest.config.ts --maxWorkers=2",
    "dev:ui": "vite --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.2",
    "@anthropic-ai/claude-agent-sdk": "0.3.308",
    "@dagrejs/dagre": "3.1.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "dompurify": "3.4.16",
    "fzstd": "0.1.1",
    "marked": "18.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "playwright": "1.64.0-alpha-1790635538000",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "file:../../../stubs/no-claude-binary-0.0.0.tgz",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "file:../../../stubs/no-claude-binary-0.0.0.tgz",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "file:../../../stubs/no-claude-binary-0.0.0.tgz",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "file:../../../stubs/no-claude-binary-0.0.0.tgz",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "file:../../../stubs/no-claude-binary-0.0.0.tgz",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "file:../../../stubs/no-claude-binary-0.0.0.tgz",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "file:../../../stubs/no-claude-binary-0.0.0.tgz",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "file:../../../stubs/no-claude-binary-0.0.0.tgz"
  }
}
