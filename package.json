{
  "name": "helm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "bin": { "helm": "dist/src/cli.js" },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "browser:install": "node node_modules/@playwright/mcp/cli.js install-browser chromium --no-shell",
    "test:browser": "npm run build && HELM_BROWSER_REAL=1 node --test dist/tests/browser.real.js",
    "start": "node dist/src/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
